					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/contacts/invited"
					}
				},
				{
					"name": "Get Single Contact",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/contacts/{{contact_id}}"
					}
				},
				{
					"name": "Create Contact",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.data && res.data.id) pm.collectionVariables.set('contact_id', res.data.id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/contacts",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"محمد علي\",\n  \"phone\": \"966511111111\",\n  \"gender\": \"mr\",\n  \"event_id\": {{event_id}}\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				},
				{
					"name": "Update Contact",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/contacts/{{contact_id}}",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"محمد علي محدّث\",\n  \"phone\": \"966511111112\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				},
				{
					"name": "Delete Contact",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/contacts/{{contact_id}}"
					}
				}
			]
		},
		{
			"name": "🗂️ Categories",
			"item": [
				{
					"name": "Get All Categories",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": "{{base_url}}/categories"
					}
				},
				{
