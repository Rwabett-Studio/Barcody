{
	"info": {
		"name": "Barcody API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8000/api" },
		{ "key": "token", "value": "" },
		{ "key": "event_id", "value": "1" },
		{ "key": "contact_id", "value": "1" },
		{ "key": "category_id", "value": "1" }
	],
	"item": [
		{
			"name": "🔐 Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": "{{base_url}}/auth/register",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@test.com\",\n  \"phone\": \"966500000001\",\n  \"password\": \"Test@1234\",\n  \"password_confirmation\": \"Test@1234\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				},
				{
					"name": "Login (Email)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.phone) pm.collectionVariables.set('phone', res.phone);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": "{{base_url}}/auth/login",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@test.com\",\n  \"password\": \"Test@1234\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				},
				{
					"name": "Login (Phone Only)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": "{{base_url}}/auth/phone-login",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"966500000001\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				},
				{
					"name": "Verify OTP → Get Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.access_token) pm.collectionVariables.set('token', res.access_token);",
									"console.log('Token saved:', res.access_token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": "{{base_url}}/auth/verify-otp",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"966500000001\",\n  \"otp\": \"123456\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				},
				{
					"name": "Resend OTP",
					"request": {
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": "{{base_url}}/auth/resend-otp",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"966500000001\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				},
				{
					"name": "Forgot Password",
					"request": {
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": "{{base_url}}/auth/forgot-password",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@test.com\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/auth/profile"
					}
				},
				{
					"name": "Update Profile",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/auth/profile",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Updated Name\",\n  \"email\": \"updated@test.com\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/auth/logout"
					}
				},
				{
					"name": "Delete Account",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/auth/account"
					}
				}
			]
		},
		{
			"name": "📅 Events",
			"item": [
				{
					"name": "Get All Events",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": "{{base_url}}/events"
					}
				},
				{
					"name": "Get Single Event",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": "{{base_url}}/events/{{event_id}}"
					}
				},
				{
					"name": "Create Event",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.data && res.data.id) pm.collectionVariables.set('event_id', res.data.id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/events",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"حفل زفاف أحمد ومريم\",\n  \"description\": \"تشرف عائلة أحمد بدعوتكم\",\n  \"date\": \"2026-07-15\",\n  \"time\": \"20:00\",\n  \"location\": \"قاعة النخيل - الرياض\",\n  \"maps\": \"https://maps.google.com\",\n  \"category_id\": 1,\n  \"status\": \"draft\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				},
				{
					"name": "Update Event",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/events/{{event_id}}",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"حفل زفاف محدّث\",\n  \"status\": \"published\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				},
				{
					"name": "Publish Event",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/events/{{event_id}}/published"
					}
				},
				{
					"name": "Draft Event",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/events/{{event_id}}/draft"
					}
				},
				{
					"name": "Get Event Contacts",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/events/{{event_id}}/contacts"
					}
				},
				{
					"name": "Get Invited Contacts",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/events/{{event_id}}/contacts/invited"
					}
				},
				{
					"name": "Send Invitations",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/events/{{event_id}}/send-invitations",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"contacts\": [1, 2, 3]\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				},
				{
					"name": "Delete Event",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{base_url}}/events/{{event_id}}"
					}
				}
			]
		},
		{
			"name": "👥 Contacts",
			"item": [
				{
					"name": "Get All Contacts",
					"request": {
						"method": "GET",
