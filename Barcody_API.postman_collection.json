{
  "info": {
    "name": "Barcody API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "token", "value": "" },
    { "key": "phone", "value": "971567616368" },
    { "key": "event_id", "value": "" },
    { "key": "contact_id", "value": "" },
    { "key": "category_id", "value": "" }
  ],
  "item": [
    {
      "name": "1) Auth",
      "item": [
        {
          "name": "Login (Email) - sends OTP",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json();", "if (r.phone) pm.collectionVariables.set('phone', r.phone);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"tester@barcody.com\",\n  \"password\": \"Test@1234\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Phone Login - sends OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/auth/phone-login",
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{phone}}\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Verify OTP -> Get Token (manual: put real OTP)",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json();", "if (r.access_token) pm.collectionVariables.set('token', r.access_token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/auth/verify-otp",
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"otp\": \"123456\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/auth/resend-otp",
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{phone}}\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/auth/forgot-password",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"tester@barcody.com\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/auth/profile"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/auth/profile",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Name\"\n}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "2) Categories",
      "item": [
        {
          "name": "Create Category",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json();", "if (r.data && r.data.id) pm.collectionVariables.set('category_id', r.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/categories",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"أفراح\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Get All Categories",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/categories" }
        },
        {
          "name": "Get Single Category",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/categories/{{category_id}}" }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/categories/{{category_id}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"أفراح وحفلات\"\n}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "3) Events",
      "item": [
        {
          "name": "Create Event",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json();", "if (r.data && r.data.id) pm.collectionVariables.set('event_id', r.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/events",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"حفل زفاف أحمد\",\n  \"description\": \"تشرف العائلة بدعوتكم\",\n  \"date\": \"2026-07-15\",\n  \"time\": \"20:00\",\n  \"location\": \"قاعة النخيل - الرياض\",\n  \"maps\": \"https://maps.google.com\",\n  \"category_id\": {{category_id}},\n  \"status\": \"draft\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Get All Events",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/events" }
        },
        {
          "name": "Get Single Event",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/events/{{event_id}}" }
        },
        {
          "name": "Publish Event",
          "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/events/{{event_id}}/published" }
        },
        {
          "name": "Draft Event",
          "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/events/{{event_id}}/draft" }
        },
        {
          "name": "Get Event Contacts",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/events/{{event_id}}/contacts" }
        }
      ]
    },
    {
      "name": "4) Contacts",
      "item": [
        {
          "name": "Create Contact",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json();", "if (r.data && r.data.id) pm.collectionVariables.set('contact_id', r.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/contacts",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"محمد علي\",\n  \"phone\": \"966511112233\",\n  \"gender\": \"mr\",\n  \"event_id\": {{event_id}}\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Get All Contacts",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/contacts" }
        },
        {
          "name": "Get Invited Contacts",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/contacts/invited" }
        },
        {
          "name": "Get Single Contact",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/contacts/{{contact_id}}" }
        },
        {
          "name": "Update Contact",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/contacts/{{contact_id}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"محمد علي محدّث\"\n}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "5) Notifications",
      "item": [
        {
          "name": "Get All Notifications",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/notifications" }
        }
      ]
    },
    {
      "name": "6) Settings",
      "item": [
        {
          "name": "Get Settings",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/settings" }
        },
        {
          "name": "Create Setting",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/settings",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Barcody\",\n  \"location\": \"الرياض\",\n  \"maps\": \"https://maps.google.com\"\n}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "7) Social Media",
      "item": [
        {
          "name": "Get Social Media",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/social-media" }
        },
        {
          "name": "Create Social Media",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/social-media",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"info@barcody.com\",\n  \"phone\": \"966500000000\",\n  \"whatsapp\": \"966500000000\",\n  \"instagram\": \"https://instagram.com/barcody\"\n}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "8) Inboxlists",
      "item": [
        {
          "name": "Get Inboxlists",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/inboxlists" }
        },
        {
          "name": "Create Inboxlist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/inboxlists",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"أحمد\",\n  \"email\": \"ahmed@test.com\",\n  \"phone\": \"966500000000\",\n  \"message\": \"رسالة تجريبية\"\n}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "9) Support Settings",
      "item": [
        {
          "name": "Get Support Settings",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/support-settings" }
        }
      ]
    },
    {
      "name": "10) Users",
      "item": [
        {
          "name": "Get All Users",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/users" }
        }
      ]
    },
    {
      "name": "11) Webhook",
      "item": [
        {
          "name": "WhatsApp Webhook (Button Response)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/webhook-data",
            "body": { "mode": "raw", "raw": "{\n  \"entry\": [\n    {\n      \"changes\": [\n        {\n          \"value\": {\n            \"messages\": [\n              {\n                \"type\": \"button\",\n                \"from\": \"966511112233\",\n                \"button\": { \"text\": \"حضور\" }\n              }\n            ]\n          }\n        }\n      ]\n    }\n  ]\n}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "12) Cleanup (deletes test data)",
      "item": [
        {
          "name": "Delete Contact",
          "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/contacts/{{contact_id}}" }
        },
        {
          "name": "Delete Event",
          "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/events/{{event_id}}" }
        },
        {
          "name": "Delete Category",
          "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/categories/{{category_id}}" }
        }
      ]
    }
  ]
}
